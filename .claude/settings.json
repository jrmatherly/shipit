{
  "permissions": {
    "allow": [
      "mcp__plugin_playwright_playwright__browser_take_screenshot",
      "Bash(pnpm build)",
      "Bash(pnpm build:*)",
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm validate)",
      "Bash(pnpm tsp:*)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm typecheck)",
      "Bash(gh run list *)",
      "Bash(gh run watch *)",
      "Bash(gh pr *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/block-generated-files.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/format-tsp.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": ".claude/hooks/check-story-exists.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": ".claude/hooks/check-layer-violations.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": ".claude/hooks/check-mock-completeness.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": ".claude/hooks/run-related-tests.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": ".claude/hooks/check-i18n-parity.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": ".claude/hooks/check-agent-labels.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  }
}
